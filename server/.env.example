# Filament Tracker server settings. Copy to server/.env (never committed) and fill in.
# Every setting is optional; the defaults suit local development. See the Configuration
# table in docs/SPEC.md.

# --- Database ---------------------------------------------------------------
# SQLite file, relative to server/. The server creates and upgrades it on startup.
DATABASE_URL=sqlite:///./data/filament.db

# --- Backups ----------------------------------------------------------------
# Where the nightly backup goes (03:00 in TZ, newest 14 kept). Unset: no backups.
# BACKUP_DIR=./data/backups

# --- Settings key -----------------------------------------------------------
# Encrypts the passwords and tokens saved on the Settings page: 32 random bytes in base64.
# Unset: the server creates data/settings.key beside the database. Keep the key with your
# backups (or set it here): without it, saved secrets must be entered again.
# Generate one with: python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# SETTINGS_KEY=

# --- Printers ---------------------------------------------------------------
# Printers are added on the Devices page. PRINTERS adds each of its serials once, the
# first time the server sees it; after that the printer is edited in the app.
# A JSON list, on one line. port is optional (default 8883); host and port may be an
# MQTT proxy's. The access code is on the printer's screen with its network settings.
# PRINTERS=[{"name": "P1S", "host": "192.168.1.40", "serial": "01P00A000000000", "access_code": "00000000"}]

# --- Home Assistant ---------------------------------------------------------
# The Home Assistant settings below can also be set on the Settings page (Admin), where a
# saved value is used instead of the one here.
# The MQTT broker Home Assistant uses (for the Mosquitto add-on, Home Assistant's address on
# port 1883), for discovery entities. Use mqtts:// for a broker with a trusted certificate.
# Unset: nothing is published. Put the user and password here, not in the URL.
# MQTT_URL=mqtt://homeassistant.local:1883
# MQTT_USER=filament-tracker
# MQTT_PASSWORD=
# Home Assistant's MQTT discovery prefix; change it only if you changed it in Home Assistant.
# HA_DISCOVERY_PREFIX=homeassistant
# Home Assistant's address and a long-lived access token (your profile > Security), for
# firing events to automations. Unset: no events are fired.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=

# --- Tag keys ---------------------------------------------------------------
# The published key-derivation constant for Bambu tags, as hex. Not generated: copy it
# from the Bambu RFID research (see server/README.md), then check it with
# `uv run ft-sim check-salt C:\tag-dumps\*.zip`. Served to scanners and the phone app.
# The starting value: a salt saved on the Settings page (Scanners) is used instead.
# BAMBU_KDF_SALT=

# --- General ----------------------------------------------------------------
# The time zone every time in the web app is shown in, and when the nightly backup runs.
# An IANA name. Unset: UTC. The Settings page (General) can change it.
# TZ=America/New_York

# --- Web sign-in ------------------------------------------------------------
# How long a sign-in lasts, in days (1 to 365). The Settings page (General) can change it.
SESSION_DAYS=30
# Keep true in production (HTTPS). Set false only to sign in over plain HTTP from another
# machine on the LAN; http://localhost works either way.
COOKIE_SECURE=true

# --- Network trust ----------------------------------------------------------
# LAN ranges allowed to use bearer tokens, the scanner routes and /docs.
# Unset: the private ranges.
# TRUSTED_NETWORKS=192.168.0.0/16,10.0.0.0/8
# The reverse proxy whose X-Forwarded-For is trusted. Unset: none.
# FORWARDED_ALLOW_IPS=192.168.1.5

# --- Machine access ---------------------------------------------------------
# An Admin token for scripts and Home Assistant, accepted from TRUSTED_NETWORKS only.
# Machine tokens made on the Settings page replace it; it keeps working if set.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=

# --- Web app ----------------------------------------------------------------
# The built web app. Unset: web/build in this checkout.
# WEB_DIR=
