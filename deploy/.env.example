# Rollcall settings for Docker Compose. Copy to .env beside compose.yaml (never commit it)
# and fill it in; see docs/deploy.md. The image already sets DATABASE_URL, BACKUP_DIR and
# WEB_DIR. Most settings can be changed later on the Settings page.

# --- Compose ----------------------------------------------------------------
# The image tag: latest, or a commit SHA to pin a version.
ROLLCALL_TAG=latest
# The port on the server.
ROLLCALL_PORT=8000

# --- Network trust (set these) ----------------------------------------------
# Your LAN. Only these addresses may use bearer tokens (scanners, the phone app, Home
# Assistant), the API docs and first-start setup. Unset: every private range, which also
# includes Docker's own networks, so narrow it to your LAN.
TRUSTED_NETWORKS=192.168.1.0/24
# The reverse proxy's address, as Rollcall sees it, so its X-Forwarded-For header is
# believed. Required with a proxy: without it, every visitor through the proxy looks like
# the proxy. Unset: no proxy.
# FORWARDED_ALLOW_IPS=192.168.1.5

# --- Sign-in ----------------------------------------------------------------
# Keep true when you sign in through the HTTPS proxy. Set false to sign in over plain
# HTTP on the LAN (http://server:8000), for example before the proxy is set up.
COOKIE_SECURE=true

# --- Settings key (recommended) ---------------------------------------------
# Encrypts the passwords, tokens and access codes saved in the app: 32 random bytes in
# base64. Set here, it stays off the data volume and out of copies of it. Unset: the
# server creates /data/settings.key. Keep a copy somewhere safe: without it, saved secrets
# must be entered again.
# Generate one with: python3 -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# SETTINGS_KEY=

# --- Starting values (optional) ---------------------------------------------
# First-start setup asks for the time zone and the tag key constant if they are not set
# here. The time zone is also when the nightly backup runs (03:00).
# TZ=America/Chicago
# BAMBU_KDF_SALT=
# A Cloudflare Access service token for the phone app away from home (docs/deploy.md);
# usually saved on the Settings page instead.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# Printers are added on the Devices page; this seeds them once.
# PRINTERS=[{"name": "P1S", "host": "192.168.1.40", "serial": "01P00A000000000", "access_code": "00000000"}]
# Home Assistant: use addresses, not .local names, which the container may not resolve.
# MQTT_URL=mqtt://192.168.1.10:1883
# MQTT_USER=rollcall
# MQTT_PASSWORD=
# HA_URL=http://192.168.1.10:8123
# HA_TOKEN=
